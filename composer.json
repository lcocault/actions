{
    "name": "actions/actions",
    "description": "Gestionnaire de tâches (API REST, MCP, portail)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": { "Actions\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Actions\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit,Http",
        "migrate": "@php bin/migrate"
    },
    "config": {
        "sort-packages": true
    }
}
