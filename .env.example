# Exemple de configuration locale, sans secret. Copier en .env (ignoré par Git).
APP_ENV=local

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=actions
DB_USER=actions
DB_PASSWORD=changez-moi

# Utilisé par compose.yaml (PostgreSQL local)
POSTGRES_USER=actions
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=actions

# Origines autorisées pour POST /mcp (séparées par des virgules); vide = aucune
MCP_ALLOWED_ORIGINS=

# Noms d'hôte acceptés par le portail dans l'en-tête Host (séparés par des virgules, sans port).
# Vide = 127.0.0.1, localhost, [::1]. Protège contre le « DNS rebinding » tant qu'il n'y a pas d'authentification.
PORTAL_ALLOWED_HOSTS=

# Base dédiée aux tests d'intégration (créée à la main, voir README)
TEST_DB_NAME=actions_test
